# Copy this file to .env. The key is optional: without it the local CLIP model classifies photos.
# Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=5000
# Radius (metres) in which two reports may be treated as the same problem
DUP_RADIUS_M=250
# Completion photo must be taken within this distance (metres) of the reported location
RESOLVE_RADIUS_M=150
# Area priority: citizens reporting within AREA_RADIUS_M metres -> red / orange / yellow
AREA_RADIUS_M=1000
AREA_RED=3
AREA_ORANGE=2
